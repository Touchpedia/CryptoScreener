+        now_ms = int(time.time() * 1000)
+        for item in tasks_input:
+            if not isinstance(item, dict):
+                continue
+            timeframe = str(item.get("timeframe") or "").strip()
+            if not timeframe:
+                continue
+            candles = item.get("candles") or item.get("candles_per_symbol")
+            candles_int = None
+            if candles is not None:
