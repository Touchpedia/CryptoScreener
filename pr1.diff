+const STORAGE_KEY = "ingestion-settings-v1";
+const TIMEFRAME_OPTIONS = ["1m", "3m", "5m", "15m", "1h", "4h", "1d"];
+const MINUTES_PER_CANDLE = {
+    "1m": 1,
+    "3m": 3,
+    "5m": 5,
+    "15m": 15,
+    "1h": 60,
+    "4h": 240,
