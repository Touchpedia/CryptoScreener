+const WEBSOCKET_FRESH_MS_WARN = 30 * 60 * 1000;
+const TRADINGVIEW_INTERVAL_MAP = {
+    "1m": "1",
+    "3m": "3",
+    "5m": "5",
+    "15m": "15",
