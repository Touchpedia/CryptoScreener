+                continue
+            vol = 0.0
+            if isinstance(t, dict):
+                vol = t.get("quoteVolume") or t.get("baseVolume") or 0
+            try:
+                vol = float(vol)
+            except Exception:
+                vol = 0.0
+            rows.append((sym, vol))
+        rows.sort(key=lambda x: x[1], reverse=True)
+        symbols = [s for (s, _) in rows[:n]]
+        if symbols:
+            return symbols
+    except Exception as e:
+        print(f"?? CCXT top symbols failed: {e}")
