+      console.error(e);
+      setMsg("Start failed");
+    } finally {
+      setStarting(false);
+      setTimeout(() => { checkStatus(); loadCoverage(); }, 800);
+    }
+  }
+
+  async function stopIngestion() {
+    try {
+      setStarting(true);
+      await fetch("/api/ingestion/stop", { method: "POST" });
