+              <td style={{ padding: 6 }}>
+                {r.latest_ts ? new Date(r.latest_ts as any).toLocaleString([], {
+                  timeZone: Intl.DateTimeFormat().resolvedOptions().timeZone
+                }) : "-"}
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </div>
+  );
+}
