+const DEFAULT_WEBSOCKET_CONNECTION_LIMIT = 48;
+const WEBSOCKET_COVERAGE_READY_THRESHOLD = 0.98;
+const WEBSOCKET_COVERAGE_WARNING_THRESHOLD = 0.9;
